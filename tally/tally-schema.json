{"$id":"https://cumulativewebinc.github.io/cwi-learn/tally/tally-schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Authoring schema for a CWI wristband counter band (cwi-tally/v1). A tally is worn: the band, face, counters, and milestone rings are all token-configured; every counter carries a source, a verified flag, and a proof URL. Verified counters must cite verified facts only.","format":"cwi-tally/v1","properties":{"band":{"additionalProperties":false,"properties":{"clasp":{"additionalProperties":false,"properties":{"carries_logo":{"type":"boolean"},"logo_variant":{"enum":["circular-badge","wordmark","monogram"],"type":"string"},"note":{"type":"string"},"treatment":{"enum":["gold-badge-inlay","printed","embossed"],"type":"string"}},"required":["carries_logo","logo_variant","treatment"],"type":"object"},"closure":{"enum":["deployant","buckle","magnetic"],"type":"string"},"material":{"enum":["woven","riveted","tech-leather"],"type":"string"},"strap_color":{"pattern":"^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$","type":"string"},"strap_color_secondary":{"pattern":"^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$","type":"string"}},"required":["material","strap_color","strap_color_secondary","closure","clasp"],"type":"object"},"counters":{"description":"Every counter must carry label, value, unit, source, verified, and proof_url. Verified counters cite verified facts only.","items":{"additionalProperties":false,"properties":{"label":{"type":"string"},"proof_url":{"format":"uri","type":"string"},"source":{"type":"string"},"unit":{"enum":["plays","position","date","plays_per_week","followers","custom"],"type":"string"},"value":{"type":["number","string"]},"verified":{"type":"boolean"}},"required":["label","value","unit","source","verified","proof_url"],"type":"object"},"minItems":1,"type":"array"},"face":{"additionalProperties":false,"properties":{"bezel":{"enum":["gold-rim","steel-rim","none"],"type":"string"},"screen_bg":{"pattern":"^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$","type":"string"},"shape":{"enum":["round","square","tall"],"type":"string"}},"required":["shape","bezel","screen_bg"],"type":"object"},"format":{"const":"cwi-tally/v1","type":"string"},"identity":{"additionalProperties":false,"properties":{"logo_variant":{"enum":["circular-badge","wordmark","monogram"],"type":"string"},"name":{"type":"string"},"owner_agent":{"type":"string"}},"required":["name","owner_agent","logo_variant"],"type":"object"},"milestone_rings":{"items":{"additionalProperties":false,"properties":{"label":{"type":"string"},"ring_color":{"pattern":"^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$","type":"string"},"threshold":{"type":"string"}},"required":["threshold","ring_color","label"],"type":"object"},"type":"array"},"render":{"additionalProperties":false,"properties":{"ansi_width":{"minimum":20,"type":"integer"},"note":{"type":"string"},"overlay_note":{"type":"string"},"targets":{"items":{"enum":["html","ansi","overlay"],"type":"string"},"type":"array"}},"required":["targets","ansi_width"],"type":"object"}},"required":["format","identity","band","face","counters","milestone_rings","render"],"title":"CWI Tally schema (cwi-tally/v1)","type":"object"}