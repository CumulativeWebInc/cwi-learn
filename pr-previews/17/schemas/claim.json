{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumulativewebinc.github.io/cwi-learn/schemas/claim.json",
  "title": "CWI claim",
  "type": "object",
  "required": [
    "claim",
    "value",
    "provenance"
  ],
  "properties": {
    "claim": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "provenance.json"
      }
    }
  }
}
